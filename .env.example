# SignalDrop — example environment variables.
# Copy to .env (gitignored) and fill in. NEVER commit real secrets.
#
# In production:
#   - App Runner should access S3 via an attached IAM role, NOT hardcoded keys.
#   - Amplify injects VITE_API_BASE_URL at build time.

# --- AWS (non-secret config only) ---
AWS_REGION=eu-west-2
S3_BUCKET=signaldrop-data-matan-2026

# --- Backend artifact source ---
# "local" reads from disk, "s3" reads from S3 <bucket>/<prefix>
ARTIFACTS_SOURCE=local
ARTIFACTS_LOCAL_PATH=./artifacts
ARTIFACTS_PREFIX=processed/

# --- Backend CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# In dev this is unnecessary — Vite proxies /api → localhost:8000.
# In production, set to the deployed backend URL + /api.
VITE_API_BASE_URL=http://localhost:8000/api

# --- Optional: AI labeling (local only, never commit) ---
# Used by `make ai-labels` to enrich top trends with human-readable labels.
# The app works fully without this.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
